{{ define "fieldprivacy" }}
{{ template "header" $ }}

{{- range $n := $.Nodes }}
	{{- with $n.ID }}{{ if index .Annotations "FieldPrivacy" }}
		{{- fail (printf "FieldPrivacy: %s.id cannot be private" $n.Name) }}
	{{- end }}{{ end }}
	{{- range $f := $n.Fields }}
		{{- if and (index $f.Annotations "FieldPrivacy") $f.IsEdgeField }}
			{{- fail (printf "FieldPrivacy: %s.%s is an edge field; zeroing it breaks edge loading" $n.Name $f.Name) }}
		{{- end }}
	{{- end }}
{{- end }}

import (
	"context"
)

// Filled by the runtime package's init, like schema policies, so rules can import this package.
var FieldPrivacyRules struct {
	{{- range $n := $.Nodes }}
		{{- range $f := $n.Fields }}
			{{- if index $f.Annotations "FieldPrivacy" }}
				{{ $n.Name }}{{ $f.StructField }} func(context.Context, *Client, *{{ $n.Name }}) bool
			{{- end }}
		{{- end }}
	{{- end }}
}

func fieldPrivacyBypassed(ctx context.Context) bool {
	vc := viewer.FromContext(ctx)
	return vc.IsAllPowerful() || vc.IsOmni()
}

{{- range $n := $.Nodes }}
	{{- $private := false }}
	{{- range $f := $n.Fields }}{{ if index $f.Annotations "FieldPrivacy" }}{{ $private = true }}{{ end }}{{ end }}
	{{- if $private }}
		{{- $recv := $n.Receiver }}

		func ({{ $recv }} *{{ $n.Name }}) applyFieldPrivacy(ctx context.Context, client *Client) {
			{{- range $f := $n.Fields }}
				{{- if index $f.Annotations "FieldPrivacy" }}
					// A nil rule means the runtime package wasn't imported; hide rather than leak.
					if rule := FieldPrivacyRules.{{ $n.Name }}{{ $f.StructField }}; rule == nil || !rule(ctx, client, {{ $recv }}) {
						{{ $recv }}.{{ $f.StructField }} = *new({{ if $f.Nillable }}*{{ end }}{{ $f.Type }})
					}
				{{- end }}
			{{- end }}
		}
	{{- end }}
{{- end }}

func registerFieldPrivacy(cfg *config) {
	{{- range $n := $.Nodes }}
		{{- $private := false }}
		{{- range $f := $n.Fields }}{{ if index $f.Annotations "FieldPrivacy" }}{{ $private = true }}{{ end }}{{ end }}
		{{- if $private }}
			cfg.inters.{{ $n.Name }} = append(cfg.inters.{{ $n.Name }}, InterceptFunc(func(next Querier) Querier {
				return QuerierFunc(func(ctx context.Context, q Query) (Value, error) {
					v, err := next.Query(ctx, q)
					nodes, ok := v.([]*{{ $n.Name }})
					if !ok || len(nodes) == 0 || fieldPrivacyBypassed(ctx) {
						return v, err
					}
					client := &Client{config: nodes[0].config}
					client.init()
					for _, node := range nodes {
						node.applyFieldPrivacy(ctx, client)
					}
					return v, err
				})
			}))
			cfg.hooks.{{ $n.Name }} = append(cfg.hooks.{{ $n.Name }}, func(next Mutator) Mutator {
				return MutateFunc(func(ctx context.Context, m Mutation) (Value, error) {
					v, err := next.Mutate(ctx, m)
					node, ok := v.(*{{ $n.Name }})
					if !ok || fieldPrivacyBypassed(ctx) {
						return v, err
					}
					client := &Client{config: node.config}
					client.init()
					node.applyFieldPrivacy(ctx, client)
					return v, err
				})
			})
		{{- end }}
	{{- end }}
}
{{ end }}

{{/* Registered in newConfig so every client, including enttest and scripts, gets the rules. */}}
{{ define "config/init/fields/fieldprivacy" }}
	registerFieldPrivacy(&cfg)
{{ end }}

{{ define "runtime/fieldprivacy" }}
{{- $ent := base $.Config.Package }}
// Code generated by ent, DO NOT EDIT.

package runtime

{{- $rulePkgs := dict }}
{{- range $n := $.Nodes }}
	{{- range $f := $n.Fields }}
		{{- with $a := index $f.Annotations "FieldPrivacy" }}
			{{- if ne $a.RulePkg $.Config.Package }}
				{{- $rulePkgs = set $rulePkgs $a.RulePkg $a.RuleAlias }}
			{{- end }}
		{{- end }}
	{{- end }}
{{- end }}

import (
	"context"

	"{{ $.Config.Package }}"
	{{- range $pkg, $alias := $rulePkgs }}
		{{ $alias }} "{{ $pkg }}"
	{{- end }}
)

func init() {
	{{- range $n := $.Nodes }}
		{{- range $f := $n.Fields }}
			{{- with $a := index $f.Annotations "FieldPrivacy" }}
				{{ $ent }}.FieldPrivacyRules.{{ $n.Name }}{{ $f.StructField }} = func(ctx context.Context, client *{{ $ent }}.Client, node *{{ $ent }}.{{ $n.Name }}) bool {
					return {{ $a.RuleAlias }}.{{ $a.RuleName }}(ctx, client, node)
				}
			{{- end }}
		{{- end }}
	{{- end }}
}
{{ end }}
